[Unit]
Description=Blockvase web portal and node monitor
After=network-online.target
Wants=network-online.target
After=bitcoind.service
Wants=bitcoind.service
After=blockvase-ap.service
Wants=blockvase-ap.service
# Prefer nginx in front when present (TLS + :80); portal binds loopback only.
After=nginx.service

[Service]
Type=simple
User=__SERVICE_USER__
WorkingDirectory=__PROJECT_DIR__
Environment=PYTHONUNBUFFERED=1
Environment=ENABLE_SYSTEM_ACTIONS=true
# Loopback only — nginx terminates HTTP/HTTPS on :80/:443.
Environment=BLOCKVASE_HOST=127.0.0.1
Environment=BLOCKVASE_PORT=8080
ExecStart=__PROJECT_DIR__/scripts/run.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
